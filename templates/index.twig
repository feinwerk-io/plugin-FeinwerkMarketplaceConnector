{% extends 'admin.twig' %}

{% block content %}
<div
    vue-entry="FeinwerkMarketplaceConnector.PluginsPage"
    rows="{{ rows|json_encode }}"
    form-nonce="{{ nonce }}"
    last-updated="{{ lastUpdated|default('') }}"
    refresh-error="{{ refreshError|default('') }}"
    refresh-error-kind="{{ refreshErrorKind|default('') }}"
    self-slug="{{ selfSlug }}"
    db-held="{{ dbHeld|default([])|json_encode }}"
    feedback="{{ feedback|default({})|json_encode }}"
    action-items="{{ actionItems|default([])|json_encode }}"
    promo="{{ promo|default(null)|json_encode }}"
    batch-nonce="{{ batchNonce|default('') }}"
    batch-update-url="{{ linkTo({'action':'batchUpdate','fwmc_tab':null,'fwmc_open':null}) }}"
    batch-finish-url="{{ linkTo({'action':'batchFinish','fwmc_tab':null,'fwmc_open':null}) }}"
    console-command="{{ consoleCommand|default('') }}"
    account-url="{{ accountUrl|default('') }}"
    switch-now-url="{{ switchNowUrl|default('') }}"
    tasks-url="{{ linkTo({'action':'tasks','fwmc_tab':null,'fwmc_open':null}) }}"
    discover-url="{{ linkTo({'action':'index','fwmc_tab':null,'fwmc_open':null}) }}"
    manage-url="{{ linkTo({'action':'manage','fwmc_tab':null,'fwmc_open':null}) }}"
    licenses-url="{{ linkTo({'action':'licenses','fwmc_tab':null,'fwmc_open':null}) }}"
    error="{{ error|default('') }}"
    connected="{{ connected ? 'true' : 'false' }}"
    instance="{{ instance|default(null)|json_encode }}"
    licensing-available="{{ licensingAvailable ? 'true' : 'false' }}"
    offline-docs-url="{{ offlineDocsUrl|default('') }}"
    open-slug="{{ openSlug|default('') }}"
    initial-tab="{{ initialTab|default('') }}"
    claim-url="{{ linkTo({'action':'claimLicense','fwmc_tab':null,'fwmc_open':null}) }}"
    buy-url="{{ linkTo({'action':'buy','fwmc_tab':null,'fwmc_open':null}) }}"
    connect-url="{{ linkTo({'action':'connect','fwmc_tab':null,'fwmc_open':null}) }}"
    browse="{{ browse|default({})|json_encode }}"
    settings-url="{{ linkTo({'module':'CoreAdminHome','action':'generalSettings'}) }}"
    refresh-url="{{ linkTo({'action':'refresh','fwmc_tab':null,'fwmc_open':null}) }}"
    install-url="{{ linkTo({'action':'install','fwmc_tab':null,'fwmc_open':null}) }}"
    update-url="{{ linkTo({'action':'update','fwmc_tab':null,'fwmc_open':null}) }}"
    activate-url="{{ activateUrl|default('') }}"
    screen-state="{{ screenState|default('') }}"
    state-url="{{ linkTo({'action':'state','fwmc_tab':null,'fwmc_open':null}) }}"
></div>
{% endblock %}
